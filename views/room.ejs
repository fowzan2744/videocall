<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="ie=edge" />
  <title>VidConnect - Video Call Room</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    const ROOM_ID = "<%= room %>";
    const NAME = "<%= na %>";
    const IS_PROD = window.location.hostname.includes("render.com") || window.location.hostname.includes("onrender.com");

    tailwind.config = {
      theme: {
        extend: {
          animation: {
            "pulse-slow": "pulse 3s ease-in-out infinite",
            "bounce-subtle": "bounce 2s ease-in-out infinite",
          },
        },
      },
    };
  </script>

  <!-- PeerJS -->
  <script src="https://unpkg.com/peerjs@1.2.0/dist/peerjs.min.js" defer></script>

  <!-- Socket.IO -->
  <script src="https://cdn.socket.io/4.7.2/socket.io.min.js" defer></script>

  <!-- Your main script -->
  <script src="/script.js" defer></script>

  <style>
    .gradient-bg {
      background: linear-gradient(135deg, #1b1b1b 0%, #2a2a2a 100%);
    }

    .glass-effect {
      background: rgba(110, 60, 60, 0.1);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .video-container {
      position: relative;
      overflow: hidden;
    }

    .video-container::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
      box-shadow: inset 0 0 10px rgba(254, 254, 254, 0.468);
      z-index: 1;
      pointer-events: none;
    }

    video {
      position: relative;
      z-index: 2;
    }

    .user-label {
      position: absolute;
      bottom: 10px;
      left: 10px;
      z-index: 10;
      background: rgba(0, 0, 0, 0.7);
      color: white;
      padding: 4px 8px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 500;
    }
  </style>
</head>

<body class="min-h-screen gradient-bg">
  <!-- === Your UI HTML here === -->
  
  <!-- For example: -->
  <header class="glass-effect border-b border-white/20">
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-lg">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-xl font-bold text-white">VidConnect</h1>
            <p class="text-sm text-white/70">Room: <span id="room-id" class="font-mono"><%= room %></span></p>
          </div>
        </div>

        <div class="flex items-center space-x-4">
          <div class="text-right">
            <p class="text-white font-medium">Welcome, <%= na %>!</p>
            <p class="text-white/70 text-sm">
              <span id="participant-count">1</span> participant(s)
            </p>
          </div>
          <button
            onclick="copyRoomId()"
            class="glass-effect text-white px-4 py-2 rounded-lg hover:bg-white/20 transition-all duration-200 text-sm font-medium"
          >
            Copy Room ID
          </button>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-6 py-8">
    <div id="video-grid" class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"></div>

    <div id="nameesss" class="hidden"></div>
  </main>

  <div class="fixed bottom-6 left-1/2 transform -translate-x-1/2 z-50">
    <div class="glass-effect rounded-2xl p-4 shadow-2xl">
      <div class="flex items-center space-x-4">
        <button
          id="muteButton"
          class="w-12 h-12 bg-red-500 hover:bg-red-600 text-white rounded-full flex items-center justify-center transition-all duration-200 transform hover:scale-110 shadow-lg"
          title="Mute/Unmute"
        >
          <svg
            id="mute-icon"
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
            ></path>
          </svg>
        </button>

        <button
          id="pauseButton"
          class="w-12 h-12 bg-blue-500 hover:bg-blue-600 text-white rounded-full flex items-center justify-center transition-all duration-200 transform hover:scale-110 shadow-lg"
          title="Turn Camera On/Off"
        >
          <svg
            id="video-icon"
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
            ></path>
          </svg>
        </button>

        <button
          id="screenShareButton"
          class="w-12 h-12 bg-green-500 hover:bg-green-600 text-white rounded-full flex items-center justify-center transition-all duration-200 transform hover:scale-110 shadow-lg"
          title="Share Screen"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
        </button>

        <button
          id="leaveButton"
          class="w-12 h-12 bg-red-600 hover:bg-red-700 text-white rounded-full flex items-center justify-center transition-all duration-200 transform hover:scale-110 shadow-lg"
          title="Leave Meeting"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="connection-status"
    class="fixed top-20 right-6 z-40"
  >
    <div class="glass-effect rounded-lg p-3 text-white text-sm">
      <div class="flex items-center space-x-2">
        <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse-slow"></div>
        <span>Connected</span>
      </div>
    </div>
  </div>

  <div
    id="loading-overlay"
    class="fixed inset-0 bg-black/50 flex items-center justify-center z-50"
  >
    <div class="glass-effect rounded-2xl p-8 text-center">
      <div
        class="animate-spin rounded-full h-12 w-12 border-b-2 border-white mx-auto mb-4"
      ></div>
      <p class="text-white text-lg">Connecting to room...</p>
      <p class="text-white/70 text-sm mt-2">
        Please allow camera and microphone access
      </p>
    </div>
  </div>

  <div
    id="success-toast"
    class="fixed top-6 right-6 z-50 transform translate-x-full transition-transform duration-300"
  >
    <div
      class="glass-effect rounded-lg p-4 text-white shadow-2xl"
    >
      <div class="flex items-center space-x-2">
        <svg
          class="w-5 h-5 text-green-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 13l4 4L19 7"
          ></path>
        </svg>
        <span>Room ID copied to clipboard!</span>
      </div>
    </div>
  </div>

  <!-- Copy Room ID & UI logic -->
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      // Copy Room ID function exposed globally
      window.copyRoomId = function () {
        const roomId = document.getElementById('room-id').textContent;
        navigator.clipboard.writeText(roomId).then(() => {
          const toast = document.getElementById('success-toast');
          if (toast) {
            toast.classList.remove('translate-x-full');
            setTimeout(() => toast.classList.add('translate-x-full'), 3000);
          }
        });
      };

      // Hide loading overlay safely
      const loadingOverlay = document.getElementById('loading-overlay');
      if (loadingOverlay) {
        setTimeout(() => {
          loadingOverlay.style.display = 'none';
        }, 2000);
      }

      // Leave button handler with null check
      const leaveButton = document.getElementById('leaveButton');
      if (leaveButton) {
        leaveButton.addEventListener('click', () => {
          if (confirm("Are you sure you want to leave the meeting?")) {
            window.location.href = "/";
          }
        });
      }
    });
  </script>
</body>
</html>
